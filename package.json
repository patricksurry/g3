{
   "name": "@patricksurry/g3",
   "version": "0.4.0",
   "author": "Patrick Surry <patrick.surry@gmail.com>",
   "description": "A flexible Javascript framework for building steam gauge instrument panels that display live external metrics from flight (or other) simulators like XPlane or MS FS2020",
   "keywords": [
      "G3",
      "D3",
      "SVG",
      "flight",
      "simulator",
      "gauges",
      "instruments",
      "control panel",
      "metrics",
      "telemetry",
      "dashboard",
      "visualization",
      "dataviz",
      "XPlane",
      "FS2020"
   ],
   "license": "ISC",
   "type": "module",
   "main": "./dist/g3.js",
   "types": "./dist/g3.d.ts",
   "exports": {
      ".": {
         "types": "./dist/g3.d.ts",
         "default": "./dist/g3.js"
      },
      "./contrib": {
         "types": "./dist/g3-contrib.d.ts",
         "default": "./dist/g3-contrib.js"
      },
      "./package.json": "./package.json"
   },
   "files": [
      "dist"
   ],
   "engines": {
      "node": ">=22.0.0"
   },
   "homepage": "https://github.com/patricksurry/g3",
   "repository": {
      "type": "git",
      "url": "https://github.com/patricksurry/g3.git"
   },
   "scripts": {
      "lint": "eslint src/ tests/ scripts/",
      "typecheck": "tsc --noEmit",
      "test": "vitest run",
      "test:watch": "vitest",
      "test:coverage": "vitest run --coverage",
      "test:render": "vitest run tests/contrib.render.test.ts",
      "docs": "UPDATE_CONTRIB=1 vitest run tests/contrib.render.test.ts",
      "build": "rollup -c && tsc -p tsconfig.build.json",
      "prepack": "npm run build",
      "start": "vite"
   },
   "dependencies": {
      "@emotion/css": "^11.13.5",
      "convert-units": "^3.0.0-beta.3",
      "d3": "^7.9.0"
   },
   "devDependencies": {
      "@rollup/plugin-node-resolve": "^13.0.4",
      "@rollup/plugin-typescript": "^12.3.1",
      "@types/d3": "^7.4.3",
      "@types/node": "^26.6.6",
      "@typescript-eslint/eslint-plugin": "^8.72.2",
      "@typescript-eslint/parser": "^8.72.2",
      "@vitest/coverage-v8": "^5.1.0",
      "eslint": "^8.9.0",
      "jsdom": "^29.1.1",
      "rollup-plugin-inject-process-env": "^1.3.1",
      "rollup-plugin-terser": "^7.0.2",
      "tslib": "^2.9.1",
      "typescript": "~5.7.3",
      "vite": "^7.0.0",
      "vitest": "^5.1.0"
   }
}
